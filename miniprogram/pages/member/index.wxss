.member-head { display: flex; gap: 20rpx; align-items: center; }
.avatar { width: 110rpx; height: 110rpx; border-radius: 50%; background: linear-gradient(135deg, #1f6feb, #38bdf8); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 44rpx; }
.name { font-size: 34rpx; font-weight: 700; }
.chips { display: flex; gap: 10rpx; margin-top: 10rpx; flex-wrap: wrap; }
.quick { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-bottom: 20rpx; }
.quick-item { background: #fff; border-radius: 16rpx; padding: 20rpx; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.quick-num { font-size: 32rpx; font-weight: 700; color: #1f6feb; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.tab { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 12rpx; background: #fff; color: #606266; font-size: 26rpx; }
.tab.active { background: #1f6feb; color: #fff; }
.coupon { border-left: 8rpx solid #1f6feb; }
.coupon.used { opacity: 0.5; border-left-color: #c0c4cc; }
.coupon-name { font-weight: 600; }
.point-row { display: flex; justify-content: space-between; align-items: center; }
.plus { color: #67c23a; font-weight: 700; }
.minus { color: #f56c6c; font-weight: 700; }
