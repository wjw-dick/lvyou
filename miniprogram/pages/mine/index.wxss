.user-card { display: flex; gap: 20rpx; align-items: center; }
.avatar { width: 110rpx; height: 110rpx; border-radius: 50%; background: linear-gradient(135deg, #1f6feb, #38bdf8); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 44rpx; }
.name { font-size: 34rpx; font-weight: 700; }
.mt8 { margin-top: 10rpx; }
.menu { padding: 0 24rpx; }
.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 0; border-top: 1rpx solid #f2f3f5; font-size: 28rpx; }
.menu-item:first-child { border-top: none; }
