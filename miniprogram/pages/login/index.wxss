.head { text-align: center; padding: 50rpx 0 30rpx; }
.logo { width: 110rpx; height: 110rpx; border-radius: 26rpx; background: linear-gradient(135deg, #1f6feb, #38bdf8); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 48rpx; margin: 0 auto 16rpx; }
.head .title { font-size: 38rpx; font-weight: 700; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.tab { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 12rpx; background: #fff; color: #606266; font-size: 26rpx; }
.tab.active { background: #1f6feb; color: #fff; }
.tip { text-align: center; margin-top: 20rpx; }
