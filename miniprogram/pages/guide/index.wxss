.tabs { display: flex; background: #fff; padding: 16rpx 24rpx; gap: 12rpx; }
.tab { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 12rpx; background: #f5f7fa; color: #606266; font-size: 26rpx; }
.tab.active { background: #1f6feb; color: #fff; }
.card.selected { border: 2rpx solid #1f6feb; }
.s-title { font-size: 30rpx; font-weight: 600; }
.tourist-row, .supplier-row { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 0; border-top: 1rpx solid #f2f3f5; font-size: 26rpx; }
.tourist-row:first-of-type { border-top: none; }
.phone { color: #1f6feb; font-size: 24rpx; }
.plus { color: #67c23a; }
.minus { color: #f56c6c; }
.mt8 { margin-top: 12rpx; }
